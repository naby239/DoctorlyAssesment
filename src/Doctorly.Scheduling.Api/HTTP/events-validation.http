# Failure cases. Each should return an RFC 7807 problem+json body, not a stack trace.

### Blank title and an end time before the start - both errors returned at once
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "",
  "startTime": "2026-03-02T10:00:00Z",
  "endTime": "2026-03-02T09:00:00Z"
}

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
    client.test("Both failures reported together", function () {
        client.assert(response.body.errors.Title !== undefined, "Title error missing");
        client.assert(response.body.errors.EndTime !== undefined, "EndTime error missing");
    });
%}

### Title longer than 200 characters
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Consultation Consultation Consultation Consultation Consultation Consultation Consultation Consultation Consultation Consultation Consultation Consultation Consultation Consultation Consultation Consultation",
  "startTime": "2026-03-02T09:00:00Z",
  "endTime": "2026-03-02T09:30:00Z"
}

### Start and end at the same moment
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Consultation",
  "startTime": "2026-03-02T09:00:00Z",
  "endTime": "2026-03-02T09:00:00Z"
}

### The same attendee invited twice in one request
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Consultation",
  "startTime": "2026-03-02T09:00:00Z",
  "endTime": "2026-03-02T09:30:00Z",
  "attendees": [
    { "name": "Anna Weber", "email": "anna@practice.de" },
    { "name": "Anna Weber", "email": "ANNA@practice.de" }
  ]
}

### Attendee with a malformed email address
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Consultation",
  "startTime": "2026-03-02T09:00:00Z",
  "endTime": "2026-03-02T09:30:00Z",
  "attendees": [
    { "name": "Anna Weber", "email": "not-an-email" }
  ]
}

### Attendee with no name
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Consultation",
  "startTime": "2026-03-02T09:00:00Z",
  "endTime": "2026-03-02T09:30:00Z",
  "attendees": [
    { "name": "", "email": "anna@practice.de" }
  ]
}

### Unknown route - should still be problem+json
GET {{host}}/api/does-not-exist

### Page below 1
GET {{host}}/api/events?page=0

### Page size above the 100 maximum
GET {{host}}/api/events?pageSize=500

### 'To' before 'From'
GET {{host}}/api/events?from=2026-03-05T00:00:00Z&to=2026-03-01T00:00:00Z

### Malformed id
GET {{host}}/api/events/not-a-guid

### Timestamp with no offset - ambiguous, rejected rather than guessed at
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Consultation",
  "startTime": "2026-03-02T09:00:00",
  "endTime": "2026-03-02T09:30:00"
}

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}

### An explicit offset is fine - stored as 07:00Z
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Consultation in Berlin local time",
  "startTime": "2026-03-02T09:00:00+02:00",
  "endTime": "2026-03-02T09:30:00+02:00"
}

### Query filter with no offset - rejected the same way a request body would be
GET {{host}}/api/events?from=2026-06-10T11:00:00&to=2026-06-10T13:00:00

> {%
    client.test("400 Bad Request", function () {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}

### Query filter with an explicit offset
GET {{host}}/api/events?from=2026-06-10T13:00:00%2B02:00&to=2026-06-10T15:00:00%2B02:00

### Update with no If-Match header at all
PUT {{host}}/api/events/{{eventId}}
Content-Type: application/json

{
  "title": "No precondition",
  "startTime": "2026-03-02T16:00:00Z",
  "endTime": "2026-03-02T16:30:00Z"
}

> {%
    client.test("428 Precondition Required", function () {
        client.assert(response.status === 428, "Expected 428, got " + response.status);
    });
%}

### Update with a malformed If-Match
PUT {{host}}/api/events/{{eventId}}
Content-Type: application/json
If-Match: "not-a-guid"

{
  "title": "Bad precondition",
  "startTime": "2026-03-02T16:00:00Z",
  "endTime": "2026-03-02T16:30:00Z"
}

### Update an event that does not exist
PUT {{host}}/api/events/00000000-0000-0000-0000-000000000001
Content-Type: application/json
If-Match: "00000000-0000-0000-0000-000000000002"

{
  "title": "Nobody",
  "startTime": "2026-03-02T16:00:00Z",
  "endTime": "2026-03-02T16:30:00Z"
}

### Cancel with no If-Match
DELETE {{host}}/api/events/{{eventId}}

### Cancel an already-cancelled event
DELETE {{host}}/api/events/{{eventId}}?reason=Again
If-Match: "{{eventVersion}}"

### Cancel an event that does not exist
DELETE {{host}}/api/events/00000000-0000-0000-0000-000000000001
If-Match: "00000000-0000-0000-0000-000000000002"
