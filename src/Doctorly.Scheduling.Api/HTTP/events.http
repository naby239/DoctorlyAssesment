# Create event. Run top to bottom - later requests reuse the id and version captured here.
# Start the API first: dotnet run --project src/Doctorly.Scheduling.Api

### Health check
GET {{host}}/health

### Schedule an event with two attendees
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Consultation",
  "description": "Annual check-up",
  "startTime": "2026-03-02T09:00:00Z",
  "endTime": "2026-03-02T09:30:00Z",
  "attendees": [
    {
      "name": "Anna Weber",
      "email": "Anna.Weber@practice.de",
      "contactNumber": "+49 30 1234567"
    },
    {
      "name": "Dr Klein",
      "email": "klein@practice.de",
      "optInNotify": false
    }
  ]
}

> {%
    client.global.set("eventId", response.body.id);
    client.global.set("eventVersion", response.body.version);
    client.global.set("attendeeId", response.body.attendees[0].attendeeId);

    client.test("201 Created", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.test("ETag returned", function () {
        client.assert(response.headers.valueOf("ETag") !== null, "No ETag header");
    });
    client.test("Email stored lower case", function () {
        client.assert(response.body.attendees[0].email === "anna.weber@practice.de");
    });
    client.test("Invitations start as Pending", function () {
        client.assert(response.body.attendees[0].status === "Pending");
    });
%}

### Schedule a second event for the same patient - the attendee should be reused, not duplicated
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Follow-up",
  "description": "Review results",
  "startTime": "2026-03-09T09:00:00Z",
  "endTime": "2026-03-09T09:30:00Z",
  "attendees": [
    {
      "name": "Anna Weber",
      "email": "ANNA.WEBER@PRACTICE.DE"
    }
  ]
}

> {%
    client.test("Existing attendee reused", function () {
        client.assert(
            response.body.attendees[0].attendeeId === client.global.get("attendeeId"),
            "A duplicate attendee was created instead of reusing the existing one");
    });
%}

### Schedule an event with no attendees
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Practice meeting",
  "startTime": "2026-03-03T14:00:00Z",
  "endTime": "2026-03-03T15:00:00Z"
}

### Get a single event with its attendees - the ETag here is needed to update it later
GET {{host}}/api/events/{{eventId}}

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("ETag returned", function () {
        client.assert(response.headers.valueOf("ETag") !== null, "No ETag header");
    });
%}

### Get an event that does not exist
GET {{host}}/api/events/00000000-0000-0000-0000-000000000001

### List every event, newest window first
GET {{host}}/api/events

### Filter by date window - returns events overlapping it, not only those fully inside
GET {{host}}/api/events?from=2026-03-01T00:00:00Z&to=2026-03-03T00:00:00Z

### Search the title and description
GET {{host}}/api/events?search=knee

### Search is case-insensitive
GET {{host}}/api/events?search=CONSULT

### Everything a given patient is booked into
GET {{host}}/api/events?attendeeEmail=ANNA.WEBER@PRACTICE.DE

### Only cancelled events
GET {{host}}/api/events?status=Cancelled

### Paging
GET {{host}}/api/events?page=1&pageSize=2

### Filters combine
GET {{host}}/api/events?from=2026-03-01T00:00:00Z&to=2026-04-01T00:00:00Z&status=Scheduled&search=test&page=1&pageSize=10

### Update the event - If-Match carries the version captured by the create above
PUT {{host}}/api/events/{{eventId}}
Content-Type: application/json
If-Match: "{{eventVersion}}"

{
  "title": "Consultation (rescheduled)",
  "description": "Moved to the afternoon at the patient's request",
  "startTime": "2026-03-02T14:00:00Z",
  "endTime": "2026-03-02T14:30:00Z"
}

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Version moved on", function () {
        client.assert(response.body.version !== client.global.get("eventVersion"),
            "The version did not change after an update");
    });
    client.global.set("staleVersion", client.global.get("eventVersion"));
    client.global.set("eventVersion", response.body.version);
%}

### Repeat the update with the now-stale version - this is the lost update, refused
PUT {{host}}/api/events/{{eventId}}
Content-Type: application/json
If-Match: "{{staleVersion}}"

{
  "title": "Should not overwrite",
  "startTime": "2026-03-02T16:00:00Z",
  "endTime": "2026-03-02T16:30:00Z"
}

> {%
    client.test("412 Precondition Failed", function () {
        client.assert(response.status === 412, "Expected 412, got " + response.status);
    });
%}

### Confirm the first writer's change survived
GET {{host}}/api/events/{{eventId}}
