{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SchedulingDatabase": "Data Source=doctorly-scheduling.db"
  },
  "Notifications": {
    "FromName": "Doctorly Practice",
    "FromAddress": "appointments@doctorly.de",
    "Email": {
      "Enabled": true,
      "Delivery": "FileDrop",
      "DropDirectory": "artifacts/notifications",
      "SmtpHost": "localhost",
      "SmtpPort": 2525
    },
    "WhatsAppEnabled": false,
    "PushEnabled": false
  }
}
